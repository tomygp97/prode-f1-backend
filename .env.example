# --- Obligatorias (la app no arranca sin ellas) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"
# Un string largo y aleatorio. En producción, distinto al de desarrollo.
JWT_SECRET="your_jwt_secret_here"

# --- Opcionales ---
# Puerto HTTP (las plataformas de deploy suelen definirlo solas). Por defecto 8080.
PORT=8080
# Orígenes del front permitidos por CORS, separados por coma. Por defecto http://localhost:3000.
# Ej. producción: CORS_ORIGIN="https://prode-f1.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Expone los endpoints /dev (correr crons a mano). Solo en desarrollo, NUNCA en producción.
ENABLE_DEV_TOOLS=true
