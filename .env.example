# --- Obligatorias (la app no arranca sin ellas) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"
# Un string largo y aleatorio. En producción, distinto al de desarrollo.
JWT_SECRET="your_jwt_secret_here"

# --- Opcionales ---
# Puerto HTTP (las plataformas de deploy suelen definirlo solas). Por defecto 8080.
PORT=8080
# Orígenes del front permitidos por CORS, separados por coma. Por defecto http://localhost:3000.
# Ej. producción: CORS_ORIGIN="https://prode-f1.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# --- Base con SSL (bases administradas, ej. Aiven). En local con Docker, no hace falta ---
# Cifra la conexión de la app.
# DATABASE_SSL=true
# Certificado CA de la base (Aiven: "CA certificate"). Con él, además se verifica al servidor.
# Se puede pegar en una línea con los saltos escapados como \n.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Las migraciones (prisma migrate deploy) leen DATABASE_URL directo: con SSL agregale
# ?sslaccept=accept_invalid_certs al final (cifra la conexión de la migración).
# Si la contraseña tiene caracteres especiales (@ # / ? :), escribilos percent-encoded (ej. @ = %40).

# Expone los endpoints /dev (correr crons a mano). Solo en desarrollo, NUNCA en producción.
ENABLE_DEV_TOOLS=true
